# Copy to .env.local and fill in. Never commit .env.local.
# Find these at: https://supabase.com/dashboard/project/<id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts that need elevated access (e.g. seeding) and by
# the admin user-management Server Actions. Never expose to the browser.
# Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute URL of the deployed site. Used when generating invite-email
# redirect links so the email points back to the right environment.
# Locally this defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
