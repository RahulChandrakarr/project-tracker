# Copy to .env.local and fill in. Never commit .env.local.
# Find these at: https://supabase.com/dashboard/project/<id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts that need elevated access (e.g. seeding).
# Never expose to the browser. Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
